# Environment variables for code-jb.dev (copy to .env and fill in real values).
# Django does not load this file automatically: export the variables in the shell,
# or pass the file to the process manager (e.g. systemd EnvironmentFile=).
# Never commit a file that contains real values.

# Required when DEBUG=False. Generate a new value on the server with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True or False. Defaults to False when unset. Use True only for local development.
DEBUG=False

# Comma-separated host names. For local development with DEBUG=True this can stay empty
# (localhost is allowed automatically), or use: localhost,127.0.0.1
ALLOWED_HOSTS=www.code-jb.dev,code-jb.dev

# Comma-separated origins including the scheme.
CSRF_TRUSTED_ORIGINS=https://www.code-jb.dev,https://code-jb.dev

# HTTPS-only options (True or False, default False).
# Enable after nginx serves the site over HTTPS and sends X-Forwarded-Proto.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
